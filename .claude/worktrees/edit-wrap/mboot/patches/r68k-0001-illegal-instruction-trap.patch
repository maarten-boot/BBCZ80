From 2d92829043e4a68eff935b93b82c69c4d5a09f2f Mon Sep 17 00:00:00 2001
From: mboot <mboot@deb-gui-usa.rl.lan>
Date: Tue, 20 Oct 2026 06:13:12 -0400
Subject: [PATCH r68k] Take the illegal instruction exception for real illegal
 opcodes

illegal_instruction_handler() returned 1 ("handled") for every illegal
opcode, not only for the firmware trap (d7 = 0xF0F0F0xx, d6 = 0xAA55AA55),
so Musashi skipped them silently: the ILLEGAL instruction, 68020-only
opcodes on the 68010 and corrupt code all ran on as no-ops.  This also
made the Minix CPU probe (movec cacr, illegal below the 68020) report a
68020.  Return 0 for anything that is not a firmware trap, so the CPU takes
vector 4 (or the line A/F vector) as real hardware does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 main.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/main.cpp b/main.cpp
index 7031eb7..ee9e7be 100644
--- a/main.cpp
+++ b/main.cpp
@@ -479,9 +479,13 @@ extern "C" {
                 default:
                     cerr << "<UNKNOWN OP " << hex << op << "; D7=0x" << hex << d7 << "; D6=0x" << d6 << ": IGNORED>" << endl;
             }
+
+            return 1;
         }
 
-        return 1;
+        // Not a firmware trap: a real illegal instruction, so take the
+        // exception (vector 4) as the CPU would.
+        return 0;
     }
 
     int interrupt_ack_handler(unsigned int irq) {
-- 
