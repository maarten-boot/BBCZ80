10 F%=OPENOUT("TFILE.DAT")
20 PRINT#F%,1.5,42,"str":BPUT#F%,65:BPUT#F%,"line"
30 PRINT PTR#F%
40 CLOSE#F%
50 F%=OPENIN("TFILE.DAT")
60 INPUT#F%,A,B%,C$:PRINT A;B%;C$
70 PRINT BGET#F%;" ";GET$#F%
80 PTR#F%=0:PRINT BGET#F%;PTR#F%
90 CLOSE#F%
100 F%=OPENUP("TFILE.DAT"):PTR#F%=20:BPUT#F%,66:PRINT PTR#F%:CLOSE#F%
110 PRINT OPENIN("NOSUCH.DAT")
120 F%=OPENIN("TFILE.DAT"):FOR I=0 TO 20:B%=BGET#F%:NEXT:PRINT B%:CLOSE#F%
RUN
SAVE "TPROG"
NEW
LOAD "TPROG"
LIST 10,30
10 PRINT "chained ";A%
CHAIN2=0
SAVE "TCHN"
NEW
A%=7:CHAIN "TCHN"
