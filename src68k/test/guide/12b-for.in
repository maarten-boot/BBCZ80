REM 12b-for: from the RISC OS BBC BASIC manual, chapter 12 (Control statements)
REM FOR ... NEXT
10 FOR N% = 1 TO 6
20   PRINT N%
30 NEXT N%
RUN
NEW
10 FOR N% = -5 TO 5 STEP 2
20   PRINT N%
30 NEXT N%
RUN
NEW
REM a STEP of 0.1: 1001 values printed in the manual; here the count and the last one
10 c%=0
20 FOR i=0 TO 100 STEP 0.1
30   c%+=1:last=i
40 NEXT i
50 PRINT c%;" ";last;" ";last=100
RUN
NEW
10 FOR N = 3.0 TO -1.0 STEP -2.0
20   FOR M = 2.5 TO 2.9 STEP 0.2
30     PRINT N,M
40   NEXT M
50 NEXT N
RUN
NEW
10 FOR N = 3.0 TO -1.0 STEP -2.0
20   FOR M = 2.5 TO 2.9 STEP 0.2
30     PRINT N,M
40   NEXT
50 NEXT
RUN
NEW
