REM 04c-save: from the RISC OS BBC BASIC manual, chapter 4 (Simple programming)
10 REM >prog1
20 PRINT "Can you give me a number ";:READ number
30 PRINT "The number you entered was ";number
40 PRINT number;" squared is "; number*number
50 DATA 6
SAVE "PROG1"
LIST
RUN
NEW
LIST
LOAD "PROG1"
LIST
RUN
REM (the Z80 version needs the name: SAVE alone does not use REM >prog1)
SAVE
REM (no APPEND, LIBRARY or OVERLAY in the Z80 version)
NEW
*ERA PROG1.BBC
