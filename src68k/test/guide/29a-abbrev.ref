   10 FORI%=1TO5STEP2:PRINTI%;:NEXT:PRINT
   20 A$="ABCDEF":PRINTLEFT$(A$,2);" ";MID$(A$,3,2);" ";RIGHT$(A$,1);" ";STRING$(3,"*");INSTR(A$,"D")
   30 J%=0:WHILEJ%<2:J%+=1:ENDWHILE:PRINTJ%
   40 IF J%=2 THENPRINT"two" ELSEPRINT"not two"
   50 GOSUB200:PRINTEVAL"6*7";" ";TAN0;" ";FALSE;" ";5 AND3
   60 RESTORE300:READ x:PRINTx:PROCp
   70 CASE J% OF
   72   WHEN 1:PRINT"one"
   74   OTHERWISEPRINT"other"
   76 ENDCASE
   80 a=1:b=2:SWAPa,b:PRINTa;" ";b;" ";HIMEM>PAGE;" ";LOMEM>=PAGE
   90 ON ERROR REPORT:PRINT" (";ERR;")":GOTO110
  100 ERROR100,"own error"
  110 ON ERROR PRINTREPORT$:END
  120 F%=OPENOUT"ABBREV.DAT":BPUT#F%,65:CLOSE#F%
  130 F%=OPENIN"ABBREV.DAT":PRINTBGET#F%:CLOSE#F%
  140 REPEAT:K%=K%+1:UNTILK%=3:PRINTK%
  150 TRACEON:K%=0:TRACEOFF:PRINT
  160 ERROR200,"the end"
  200 PRINT"gosub":RETURN
