REM 28a-range: from the RISC OS BBC BASIC manual, appendix A (Numeric implementation)
REM integers, floating point numbers, fixed point numbers
PRINT 1;" ";2;" ";1024;" ";1.3;" ";123.45;" ";1.2345E2
@%=&20410:PRINT 4/3,1.23456,123.456789:@%=&90A
REM integers: 4 bytes, -2147483648 to 2147483647
PRINT 2^(32-1)-1;" ";~(2^(32-1)-1);" ";2^(32-1)-1=2147483647
A%=2147483647:B%=&80000000:PRINT ~A%;" ";~B%;" ";A%=&7FFFFFFF;" ";B%=&80000000
REM (an integer result out of range becomes floating point)
PRINT A%+1;" ";A%+1=2^31;" ";B%-1;" ";A%*2;" ";B%*-1
REM (the Z80 version: -B% and ABS(B%) of -2147483648 stay -2147483648)
PRINT -B%;" ";ABS(B%);" ";0-B%
REM integers are exact
@%=&A0A:PRINT A%;" ";B%;" ";A%-1;" ";123456789*10:@%=&90A
10 ON ERROR PRINT ERR;" ";REPORT$:END
20 A%=2147483648
RUN
20 A%=-2147483649
RUN
20 A%=A%+1:PRINT A%
RUN
NEW
REM 5-byte reals: up to 1.7E38, down to 1.5E-39, 9 significant figures
PRINT 1.7E38;" ";-1.7E38;" ";1.7E38/1E38;" ";-1.7E38/1E38
REM (the Z80 version's smallest real is 2^-127, about 5.9E-39: 1.5E-39 is 0)
PRINT 1.5E-39;" ";-1.5E-39;" ";2^-127;" ";2^-127*2^127;" ";2^-128
PRINT 1E-30/1E10;" ";1E-30/1E10=0
10 ON ERROR PRINT ERR;" ";REPORT$:END
20 PRINT 1.7E38*10
RUN
20 PRINT 2^128
RUN
20 PRINT 1E39
RUN
20 PRINT 1/0
RUN
NEW
REM accuracy: PI to 3, 6 and 9 significant figures
@%=&30A:PRINT PI:@%=&60A:PRINT PI:@%=&90A:PRINT PI
PRINT PI;" ";1/3;" ";2/3;" ";SQR(2)
@%=&20A00:PRINT PI:PRINT 1/3:@%=&90A
PRINT 123456789;" ";1234567891;" ";12345678912
PRINT 1E9+1-1E9;" ";2^32+1-2^32;" ";2^31+1-2^31
REM (the Z80 version, like BASIC V, has only 5-byte reals: no 8-byte reals)
