REM 07a-hex: from the RISC OS BBC BASIC manual, chapter 7 (Bases)
REM hexadecimal numbers start with &
PRINT &0;" ";&1;" ";&2;" ";&3;" ";&4;" ";&5;" ";&6;" ";&7
PRINT &8;" ";&9;" ";&A;" ";&B;" ";&C;" ";&D;" ";&E;" ";&F
PRINT &10;" ";&100;" ";16^2;" ";&FF;" ";&3E8;" ";&0010
REM (PRINT shows 9 significant figures: 2147483647 is 2.14748365E9; ~ shows all)
PRINT &7FFFFFFF;" ";~&7FFFFFFF;" ";&7FFFFFFF-&7FFFFFF0
PRINT &FFFFFFFF;" ";~&80000000;" ";-&10;" ";&10+&10;" ";&80000000=-2^31
PRINT ~255;" ";~&100;" ";~-1;" ";~16^2;" ";~&ABCDEF
REM binary numbers start with %
PRINT %1;" ";%10;" ";%11;" ";%100;" ";%101
PRINT %110;" ";%111;" ";%1000;" ";%1001;" ";%1010
PRINT %1000101;" ";1*64 + 0*32 + 0*16 + 0*8 + 1*4 + 0*2 + 1*1
PRINT %11111111;" ";~%10000000000000000000000000000000;" ";%0;" ";%00101
PRINT ~%01111111111111111111111111111111;" ";%1111111111111111111111111111111=&7FFFFFFF
PRINT %1010+&A;" ";&10*%10;" ";-%11
REM (the Z80 version takes upper case hex digits only: &ff is "Bad hex")
10 ON ERROR PRINT ERR;" ";REPORT$:END
20 PRINT &ff
RUN
20 PRINT &G
RUN
20 PRINT %2
RUN
20 PRINT &
RUN
NEW
