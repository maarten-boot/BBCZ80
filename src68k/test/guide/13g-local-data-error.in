REM 13g-local-data-error: from the RISC OS BBC BASIC manual, chapter 13 (Procedures and functions)
REM LOCAL DATA ... RESTORE DATA; the automatic RESTORE DATA on return
10 READ A$:PRINT A$
20 PROCown:READ A$:PRINT A$
30 PROCown2:READ A$:PRINT A$
40 END
50 DATA main1,main2,main3
1000 DEF PROCown
1005 LOCAL DATA
1010 RESTORE +0
1020 DATA own1,own2
1030 READ B$,C$:PRINT B$;" ";C$
1080 RESTORE DATA
1090 ENDPROC
1100 DEF PROCown2:LOCAL n%
1110 LOCAL DATA
1120 RESTORE +1:READ B$:PRINT B$
1130 ENDPROC
1140 DATA own3
RUN
NEW
REM ON ERROR LOCAL in a PROC; the caller's handler comes back on return
10 ON ERROR PRINT "main: ";REPORT$:END
20 PROCsafe(0):PROCsafe(4)
30 PRINT 1/0
40 DEF PROCsafe(d)
50 ON ERROR LOCAL PRINT "local: ";REPORT$:ENDPROC
60 PRINT 8/d
70 ENDPROC
RUN
NEW
