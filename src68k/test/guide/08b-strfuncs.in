REM 08b-strfuncs: from the RISC OS BBC BASIC manual, chapter 8 (String variables)
PRINT STRING$(20,"+-")
PRINT LEN("PAUL")
A$ = "Great Britain":PRINT LEN(A$)
A$ = "Great Britain":PRINT INSTR(A$,"it");INSTR(A$,"xyz")
PRINT INSTR("'ello 'ello","'ello",2)
PRINT ASC("ABC");ASC("");" ";CHR$(65);CHR$(ASC("z"));" ";ASC(CHR$(255))
PRINT VAL("10to10")
number =  VAL("-5"):PRINT number;VAL("+7");VAL("x12");VAL("")
10 radius = 5
20 area = EVAL("PI*radius^2")
30 PRINT area
40 A = 45
50 B = 30.5
60 A$ = STR$(A)
70 B$ = STR$(B)
80 PRINT A + B
90 PRINT A$ + B$
100 A$ = STR$~(A)
110 PRINT A$
RUN
NEW
