REM 12e-while: from the RISC OS BBC BASIC manual, chapter 12 (Control statements)
REM WHILE ... ENDWHILE; X += RND(5) replaced by X += 23
10 X = 0
20 WHILE X < 100
30   PRINT X
40   X += 23
50 ENDWHILE
RUN
NEW
10 A%=256
20 WHILE A%<>0
30   B%=1
40   WHILE B%<8
50     PRINT A%,B%
60     B%=B%*2
70   ENDWHILE
80   A%=A% DIV 2
90 ENDWHILE
RUN
NEW
REM REPEAT runs at least once, WHILE need not run at all
10 REPEAT
20   PRINT "Repeat"
30 UNTIL TRUE
40
50 WHILE FALSE
60   PRINT "While"
70 ENDWHILE
80
90 PRINT "All done"
RUN
NEW
REM leaving loops early: EXIT REPEAT, EXIT WHILE
10 I%=0:REPEAT I%+=1:IF I%=3 THEN EXIT REPEAT
20 UNTIL FALSE:PRINT "EXIT REPEAT at ";I%
30 I%=0:WHILE TRUE:I%+=1:IF I%=5 THEN EXIT WHILE
40 ENDWHILE:PRINT "EXIT WHILE at ";I%
50 ON ERROR PRINT REPORT$;" at line ";ERL:END
60 UNTIL TRUE
RUN
NEW
