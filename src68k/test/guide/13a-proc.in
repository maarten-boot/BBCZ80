REM 13a-proc: from the RISC OS BBC BASIC manual, chapter 13 (Procedures and functions)
REM the countdown: MODE and TAB(x,y) left out, from 5 not 30, and
REM PROCwait_1_second counts instead of waiting for TIME
20 PRINT "Countdown commencing"
30 FOR N% = 5 TO 1 STEP -1
40   PRINT N%
50   PROCwait_1_second
60 NEXT
70 PRINT "BLAST OFF";STRING$(4,"!")
75 PRINT "waits: ";W%
80 END
90
100 DEF PROCwait_1_second
110 W% += 1
120 REPEAT
130 UNTIL TRUE
140 ENDPROC
RUN
NEW
REM names: may start with a digit, contain @, start with a keyword; DEF is a REM when met
10 PROC1st:PROCa@b:PROCTO:PROCPRINT
20 DEF PROC1st:PRINT "PROC1st":ENDPROC
30 DEF PROCa@b:PRINT "PROCa@b":ENDPROC
40 DEF PROCTO:PRINT "PROCTO":ENDPROC
50 DEF PROCPRINT:PRINT "PROCPRINT":ENDPROC
60 PRINT "the DEFs were skipped"
RUN
NEW
REM (libraries: INSTALL, LIBRARY, OVERLAY and LVAR are not in BBC BASIC (Z80),
REM INSTALL is a Syntax error there; the Printout library example is left out)
