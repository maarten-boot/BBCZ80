REM LOG: from the RISC OS BBC BASIC manual, keywords chapter
PRINT LOG(2.4323)
PRINT LOG(1);LOG(10);LOG(1000);LOG(0.001);LOG(1E38);LOG(1E-38)
PRINT LOG(2)+LOG(5);LOG 100;10^LOG(7);LOG(10^3.5)
10 REM the errors for 0 and negatives
20 FOR i%=0 TO 6:PRINT LOG(10^i%);:NEXT:PRINT
30 PROCtry(0):PROCtry(-10)
40 END
70 DEF PROCtry(x):ON ERROR LOCAL PRINT "LOG(";x;"): ";ERR;" ";REPORT$:ENDPROC
80 PRINT LOG(x):ENDPROC
RUN
NEW
