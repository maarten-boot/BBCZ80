REM DEG: from the RISC OS BBC BASIC manual, keywords chapter
a=1:angle=DEG(ATN(a)):PRINT angle
PRINT DEG(PI/4)
PRINT DEG(0);DEG(PI);DEG(-PI/2);DEG(1);DEG 2*PI
PRINT DEG(RAD(30));DEG(1E30);DEG(-1E-30);DEG(3)
10 ON ERROR PRINT ERR;" ";REPORT$:GOTO 30
20 PRINT DEG(1E38)
30 ON ERROR PRINT ERR;" ";REPORT$:END
40 PRINT DEG("1")
RUN
NEW
