REM GOSUB: from the RISC OS BBC BASIC manual, keywords chapter
10 REM GOSUB, computed GOSUB, ON ... GOSUB ... ELSE
20 GOSUB 2000
30 FOR opt=0 TO 1:GOSUB (2300+20*opt): REM not nice
40 NEXT
50 FOR x%=0 TO 4
60   ON x% GOSUB 100,200,300 ELSE PRINT "Out of range ";x%
70 NEXT
80 n%=3:GOSUB 400:PRINT "back ";n%
90 ON ERROR PRINT ERR;" ";REPORT$:GOTO 110
95 GOSUB 9999
100 PRINT "not here"
110 ON ERROR PRINT ERR;" ";REPORT$:END
120 RETURN
100 PRINT "one":RETURN
200 PRINT "two":RETURN
300 PRINT "three":RETURN
400 IF n%>0 THEN PRINT n%;:n%-=1:GOSUB 400
410 RETURN
2000 PRINT "line 2000":RETURN
2300 PRINT "line 2300":RETURN
2320 PRINT "line 2320":RETURN
RUN
NEW
