REM SIN: from the RISC OS BBC BASIC manual, keywords chapter
PRINT SIN(RAD(135))
hyp=10:theta=RAD(30):opp=hyp*SIN(theta):PRINT opp
PRINT SIN(0);SIN(PI/2);SIN(-PI/2);SIN(RAD(30))
PRINT SIN 1;SIN(-1);SIN(100);SIN(PI)<1E-8
PRINT SIN(1000000);SIN(8388607)
PRINT SIN(3)^2+COS(3)^2
10 ON ERROR PRINT ERR;" ";REPORT$:END
20 PRINT SIN(1E10)
RUN
NEW
