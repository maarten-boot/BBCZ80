REM GOTO: from the RISC OS BBC BASIC manual, keywords chapter
REM (IF TIME<1000 uses a counter t here: TIME varies)
10 REM GOTO, computed GOTO, ON ... GOTO ... ELSE
20 GOTO 230
30 PRINT "not here"
230 PRINT "at 230":t=0
240 t=t+250:IF t<1000 THEN GOTO 240
250 PRINT t
260 FOR x=0 TO 5
270   ON x GOTO 300,500,400,600 ELSE PRINT "else ";x:GOTO 700
300   PRINT "300":GOTO 700
400   PRINT "400":GOTO 700
500   PRINT "500":GOTO 700
600   PRINT "600"
700 NEXT
710 n%=1:GOTO (710+n%*20)
720 PRINT "not here"
730 PRINT "730"
740 IF n% THEN 750 ELSE 720
750 ON ERROR PRINT ERR;" ";REPORT$:GOTO 770
760 GOTO 9999
770 ON ERROR PRINT ERR;" ";REPORT$:END
780 x=7:ON x GOTO 300,400
RUN
NEW
