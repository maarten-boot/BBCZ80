REM ERL: from the RISC OS BBC BASIC manual, keywords chapter
PRINT 1/0
PRINT ERL
10 ON ERROR GOTO 100
20 PRINT "start"
30 X=1/0
40 END
100 REPORT : IF ERL<>0 THEN PRINT " at line "; ERL
110 IF ERL=30 PRINT "Bad division, try again"
120 ON ERROR REPORT:PRINT " at line ";ERL:END
130 PROCa
140 DEF PROCa
150 Y=SQR(-1)
160 ENDPROC
RUN
PRINT ERL
NEW
