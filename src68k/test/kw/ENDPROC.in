REM ENDPROC: from the RISC OS BBC BASIC manual, keywords chapter
10 PROCrecurse(3):PRINT
20 x=1:PROCloc:PRINT x
30 ON ERROR PRINT ERR;" ";REPORT$:END
40 ENDPROC
50 END
60 DEF PROCrecurse(a)
70 PRINT a;
80 IF a<=0 THEN ENDPROC ELSE PROCrecurse(a-1)
90 PRINT " back";a;
100 ENDPROC
110 DEF PROCloc:LOCAL x:x=99:PRINT x:ENDPROC
RUN
ENDPROC
NEW
