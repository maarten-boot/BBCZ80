REM PRINT: from the RISC OS BBC BASIC manual, keywords chapter
PRINT "Hello there";:PRINT "|"
a=30:x=1.5:y=-2:p=7:q=8:PRINT a,SIN(RAD(a)),x,y''p,q;:PRINT "|"
REM (TAB(10,3) moves the cursor: the CP/M versions cannot; TAB(n) is used)
profits=1234.5:PRINT TAB(10)"Profits"SPC(10);profits;:PRINT "|"
PRINT 1,22,333:PRINT 1;22;333:PRINT ;1,2;3,4
PRINT ~255,~-1;" ";~16,255:PRINT ~255;' 255
PRINT "a","bb","ccc";"d";"e","f"
PRINT 1"x"2 3;"y";TAB(14)"z";SPC 3;"w"
PRINT "first"';"second"''"third"
REM @% formats: G (byte 3 = 0), E (1) and F (2)
@%=&0000090A:PRINT 1.5,0.01,1E10,7.7,-1/3
@%=&0101030A:PRINT 1.23,0.0011,123456,STR$(12.5)
@%=&00020407:PRINT 1.23,923.1,-0.5,STR$(1.5)
@%=&00000A0A:PRINT 7.7,1/3,0.1
@%=&90A:PRINT 7.7
PRINT 1E-5,123456789,1234567890,-1E38
REM (BASIC 1.05's string form @%="G10.3" is not in the Z80 version)
