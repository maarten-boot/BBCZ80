REM SQR: from the RISC OS BBC BASIC manual, keywords chapter
10 DEF FNlen(x1,y1,x2,y2)=SQR((x2-x1)^2+(y2-y1)^2)
20 PRINT FNlen(0,0,3,4);FNlen(1,1,4,5);FNlen(2,2,2,2)
30 a=1:b=-3:c=2:disc=SQR(b*b-4*a*c):PRINT disc
40 PRINT SQR(16),SQR(2),SQR(0),SQR(1E10),SQR 0.25,SQR(1E-10)
50 PRINT SQR(144),SQR(&7FFFFFFF),SQR(2)*SQR(2)
60 ON ERROR PRINT ERR;" ";REPORT$:GOTO 80
70 PRINT SQR(-1)
80 ON ERROR PRINT ERR;" ";REPORT$:END
90 PRINT SQR(-1E-30)
RUN
NEW
