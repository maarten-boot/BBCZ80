REM REPORT_STRING: from the RISC OS BBC BASIC manual, keywords chapter
10 ON ERROR PRINT REPORT$:GOTO 30
20 PRINT 1/0
30 ON ERROR LOCAL PRINT "[";REPORT$;"] ";LEN(REPORT$);" ";ERR:GOTO 50
40 ERROR 100,"A message of my own"
50 ON ERROR LOCAL PRINT "re-raised: ";REPORT$;" ";ERR:GOTO 70
60 PROCreraise
70 r$=REPORT$:PRINT "saved: ";r$
80 ON ERROR LOCAL PRINT "[";REPORT$;"]":GOTO 100
90 ERROR 5,""
100 END
110 DEF PROCreraise
120 LOCAL ERROR:ON ERROR LOCAL RESTORE ERROR:ERROR ERR,REPORT$
130 PRINT 1/0
140 ENDPROC
RUN
NEW
PRINT ASC"A"+"B"
PRINT REPORT$
PRINT LEFT$(REPORT$,4),RIGHT$(REPORT$,8)
