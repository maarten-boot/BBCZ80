REM DIV: from the RISC OS BBC BASIC manual, keywords chapter
REM (BBC BASIC (Z80): DIV 0 gives -1, not an error)
first=95:last=12:PRINT (first-last) DIV 10
space%=&1234:a%=space% DIV &100:PRINT ~a%
PRINT 21 DIV 4;-21 DIV 4;21 DIV -4;-21 DIV -4;3 DIV 4;0 DIV 5
PRINT 7.9 DIV 2;-7.9 DIV 2;7 DIV 2.9;21 MOD 4;-21 MOD 4
PRINT &7FFFFFFF DIV 3;&80000000 DIV 2;-2147483647 DIV -1;1E9 DIV 7
PRINT 21 DIV 4 * 2;2 + 21 DIV 4
10 ON ERROR PRINT ERR;" ";REPORT$:GOTO 30
20 PRINT 7 DIV 0
30 ON ERROR PRINT ERR;" ";REPORT$:GOTO 50
40 PRINT 7 DIV 0.5
50 ON ERROR PRINT ERR;" ";REPORT$:GOTO 70
60 PRINT 1E10 DIV 2
70 ON ERROR PRINT ERR;" ";REPORT$:GOTO 90
80 PRINT -2147483648 DIV 1
90 ON ERROR PRINT ERR;" ";REPORT$:END
95 PRINT "7" DIV 2
RUN
NEW
