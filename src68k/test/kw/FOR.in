REM FOR: from the RISC OS BBC BASIC manual, keywords chapter
10 REM the manual's examples, STEP, loops that run once
20 n%=0:FOR addr%=200 TO 8000 STEP 4:n%+=1:NEXT:PRINT n%
30 a$="hello":FOR I=1 TO LEN(a$):PRINT MID$(a$,I,1);"-";:NEXT:PRINT
40 FOR I=1 TO 0:PRINT "once ";I:NEXT
50 FOR i%=10 TO 1 STEP -3:PRINT i%;:NEXT:PRINT
60 FOR x=0 TO 1 STEP 0.25:PRINT x;:NEXT:PRINT
70 FOR x=1 TO -1 STEP -0.5:PRINT x;:NEXT:PRINT
80 FOR i%=1 TO 3:FOR j%=i% TO 3:PRINT i%*10+j%;:NEXT j%,i%:PRINT
90 FOR i%=5 TO 5:PRINT "five":NEXT i%
100 DIM a(3):FOR a(2)=1 TO 3:PRINT a(2);:NEXT:PRINT
110 FOR i%=1 TO 10:IF i%=4 THEN EXIT FOR
120 NEXT:PRINT "exit at ";i%
130 s=0:FOR i%=1 TO 100:s+=i%:NEXT:PRINT s
135 REM errors (NEXT unwinds a PROC's ON ERROR LOCAL, so a global ON ERROR)
140 ON ERROR PRINT ERR;" ";REPORT$:GOTO 160
150 NEXT
160 ON ERROR PRINT ERR;" ";REPORT$:GOTO 180
170 FOR a$="x" TO "y":NEXT
180 ON ERROR PRINT ERR;" ";REPORT$:GOTO 200
190 FOR i%=1 TO "x":NEXT
200 ON ERROR PRINT ERR;" ";REPORT$:END
210 FOR i%=1 TO 2:NEXT j%
RUN
NEW
