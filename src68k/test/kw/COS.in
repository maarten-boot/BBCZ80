REM COS: from the RISC OS BBC BASIC manual, keywords chapter
PRINT COS(RAD(45))
hypotenuse=10:angle=RAD(60):adjacent = hypotenuse*COS(angle):PRINT adjacent
PRINT COS(0);COS(PI);COS(PI/2);COS(-PI/3);COS(2*PI)
PRINT COS 1;COS(1E-9);COS(100);COS(8388607);COS(2)^2+SIN(2)^2
10 ON ERROR PRINT ERR;" ";REPORT$:GOTO 30
20 PRINT COS(1E10)
30 ON ERROR PRINT ERR;" ";REPORT$:END
40 PRINT COS("1")
RUN
NEW
