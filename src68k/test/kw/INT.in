REM INT: from the RISC OS BBC BASIC manual, keywords chapter
PRINT INT(1.5);INT(-1.5);INT(0);INT(-0.1);INT(0.9999);INT(7)
PRINT INT(-7);INT(2147483647.5);INT 3.7;INT -3.7;INT(-2147483647)
PRINT INT(-2147483648)
PRINT INT(1E9+0.5);INT(-1E9-0.5);INT(1/3*3);INT(123456.789)
10 REM the manual's examples
20 FOR n=-2 TO 2 STEP 0.5:PRINT FNround(n);:NEXT:PRINT
30 FOR n=-2 TO 2 STEP 0.75:PRINT FNTruncateToZero(n);:NEXT:PRINT
40 len%=3:top=750:bottom=100:size=len%*INT((top-bottom)/100):PRINT size
50 ON ERROR PRINT ERR;" ";REPORT$:GOTO 70
60 PRINT INT(3E10)
70 ON ERROR PRINT ERR;" ";REPORT$:END
80 PRINT INT("1")
90 DEF FNround(n)=INT(n+0.5)
100 DEF FNTruncateToZero(n)=SGNn*INT(ABS(n))
RUN
NEW
