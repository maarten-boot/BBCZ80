REM NOT: from the RISC OS BBC BASIC manual, keywords chapter
ok=FALSE:IF NOT ok THEN PRINT "Error in input"
ok=TRUE:IF NOT ok THEN PRINT "Error in input" ELSE PRINT "input ok"
mask%=&0000FF0F:inv%=NOT mask%:PRINT ~inv%,inv%
REM (REPEAT UNTIL NOT INKEY(-99) needs the keyboard: left out)
PRINT NOT 0,NOT -1,NOT TRUE,NOT FALSE,NOT 1
PRINT NOT &7FFFFFFF,~NOT &80000000,NOT 2.7,NOT -2.7
PRINT NOT (1=1),NOT (1=2),NOT 3=-4,NOT (3=-4)
A%=5:PRINT NOT NOT A%,NOT A% AND 7
10 ON ERROR PRINT ERR;" ";REPORT$:GOTO 30
20 PRINT NOT 1E10
30 ON ERROR PRINT ERR;" ";REPORT$:END
40 PRINT NOT "abc"
RUN
NEW
