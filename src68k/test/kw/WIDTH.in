REM WIDTH: from the RISC OS BBC BASIC manual, keywords chapter
WIDTH 0: REM 'infinite width'
PRINT "0123456789012345678901234567890123456789012345678901234567890"
WIDTH 40: REM newline every 40 characters horizontally
PRINT "0123456789012345678901234567890123456789012345678901234567890"
WIDTH 10:PRINT "abcdefghijklmnopqrstuvwxyz"
WIDTH 20:PRINT 1,2,3,4,5
WIDTH 0
PRINT "0123456789012345678901234567890123456789012345678901234567890"
REM PRINT WIDTH: the function gives Sorry (error 0) in the CP/M version
WIDTH 30:PRINT WIDTH
WIDTH 0
PRINT WIDTH
