REM CLOSE: from the RISC OS BBC BASIC manual, keywords chapter
10 indexFile=OPENOUT "KWCLOSE.DAT"
20 PRINT#indexFile,"one",2
30 CLOSE#indexFile
40 f%=OPENIN "KWCLOSE.DAT":INPUT#f%,a$,b:PRINT a$;" ";b
50 g%=OPENIN "KWCLOSE.DAT":h%=OPENUP "KWCLOSE.DAT"
60 CLOSE#0
70 ON ERROR PRINT ERR;" ";REPORT$:GOTO 90
80 PRINT BGET#g%
90 ON ERROR PRINT ERR;" ";REPORT$:END
100 INPUT#h%,a$
RUN
CLOSE#0
NEW
*ERA KWCLOSE.DAT
