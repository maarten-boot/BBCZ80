REM OR: from the RISC OS BBC BASIC manual, keywords chapter
a%=&1234:PRINT a% OR &AA55:PRINT ~a% OR &AA55
PRINT 5 OR 10,0 OR 0,-1 OR 0,-20 OR 11,~&F0F0F0F0 OR &0F0F0F0F
PRINT TRUE OR FALSE,FALSE OR FALSE,(1=2) OR (2=2),1=2 OR 2=2
PRINT 6.9 OR 1,-1.5 OR 0,~&80000000 OR 1
X%=&F0:X% OR=&0F:PRINT ~X%:Y=8:Y OR=1:PRINT Y
10 FOR a=0 TO 11 STEP 5.5
20   IF a<1 OR a>10 THEN PRINT a;" Bad range" ELSE PRINT a;" in range"
30 NEXT
40 ON ERROR PRINT ERR;" ";REPORT$:GOTO 60
50 PRINT 3E9 OR 1
60 ON ERROR PRINT ERR;" ";REPORT$:END
70 PRINT 1 OR "A"
RUN
NEW
