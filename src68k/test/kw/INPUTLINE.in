REM INPUTLINE: from the RISC OS BBC BASIC manual, keywords chapter
REM (INPUT LINE waits for the keyboard: the example is LISTed, not run)
5 GOTO 40
10 INPUT LINE ">" basic$
20 INPUT LINE "Name: " n$, "Number" n
30 INPUT LINE a$
40 IF FALSE THEN INPUT LINE "never" x$
50 PRINT "skipped the INPUT LINE"
LIST
LIST IF LINE
RUN
NEW
