REM the error messages (bbcwinc): each line from 100 on causes one; the
REM handler prints ERL, ERR and the message and goes on at the next line;
REM at the end the untrappable "No room" (PROCdeep)
10 ON ERROR PRINT ERL;" ";ERR;" ";REPORT$:IF ERL<100 OR ERL>790 THEN END ELSE GOTO (ERL+10)
20 GOTO 100
30 DEF PROCone(a):ENDPROC
40 DEF FNtwo=2
50 DEF PROCdeep(n):LOCAL s$:s$=STRING$(n,"x"):PROCdeep(n+1):ENDPROC
100 PRINT 1/0
110 PRINT 10 DIV 0
120 PRINT 10 MOD 0
130 X=SQR(-1)
140 X=LN(0)
150 X=LOG(-1)
160 X=1E38*1E38
170 X=EXP(1000)
180 X=ACS(2)
190 X%=2^31
200 X=2^1E10
210 A$=STRING$(200,"x")+STRING$(100,"y")
220 X="a"
230 A$=1
240 X$=CHR$(65)+1
250 SWAP X,A$
260 PRINT nosuchvar
270 PROCnone
280 X=FNnone
290 PROCone(1,2)
300 PROCone
310 DIM Q(-2)
320 DIM Z%(10):Z%(11)=1
330 DIM Y%(2,2):Y%(1)=1
340 DIM big(100000000)
350 PRINT (1+2
360 PRINT "abc
370 PRINT INSTR("a")
380 GOTO 9999
390 GOSUB 9999
400 NEXT
410 UNTIL TRUE
420 ENDWHILE
430 RETURN
440 ENDPROC
450 =1
460 READ X
470 ON 5 GOTO 100,110
480 ON X
490 N%=0:FOR I=1 TO 5 STEP 0:N%+=1:IF N%=3 THEN I=9
495 NEXT:PRINT "STEP 0 is not an error: ";N%
500 FOR I=1
510 CASE 1
520 X=&
530 X=EVAL("1+")
540 X=EVAL("")
550 LOCAL X
560 PRINT#99,1
570 X=BGET#0
580 ERROR 99,"My own error"
590 ERROR 1000,"Big number"
600 FOR 1=1 TO 2:NEXT
610 FOR I%=1 TO 3:NEXT J%
620 DIM W(3):W=1
630 X=SUM(X)
640 A$=LEFT$(1)
650 X=VAL
660 X=INT("1")
670 DIM V$(2):V$()=1
680 F%=OPENIN "K07NONE.XYZ":PRINT "OPENIN gives";F%
690 REM (OPENOUT "": a file with no name under CP/M, "Bad name" here)
700 F%=OPENOUT "K07TMP":CLOSE#F%:CLOSE#F%:*ERA K07TMP
710 X=TAN(PI/2):PRINT "TAN ok"
720 X=RND(-1):X=RND(0):PRINT "RND ok"
730 IF 1 THEN ELSE
740 X=2:X+=:PRINT X
750 DIM D% 10:D%?11=1:PRINT "no check"
760 PRINT -"a"
770 X=NOT "a"
780 PRINT "end of the errors"
790 ON ERROR OFF
800 PRINT 1/0
RUN
*ERA K07TMP
PRINT ERR;" ";ERL;" ";REPORT$
1234
PRINT 1+
PRINT "unclosed
X=
GOTO 50
)
PROCdeep(1)
PRINT "after No room ";ERR
