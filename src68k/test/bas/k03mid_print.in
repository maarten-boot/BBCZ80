REM keywords MID$ to PRINT, from the manual's examples (bbcwin6)
A$="BBC BASIC":PRINT MID$(A$,5);"|";MID$(A$,5,3);"|";MID$(A$,1,3);"|";MID$(A$,20);"|";MID$(A$,0,2)
A$="BBC BASIC":FOR i=1 TO 9:PRINT MID$(A$,i,1);"-";:NEXT:PRINT
A$="BBC BASIC":MID$(A$,5)="ZZZ":PRINT A$:MID$(A$,1,2)="xxxxx":PRINT A$:MID$(A$,8,9)="end":PRINT A$
PRINT 17 MOD 5,-17 MOD 5,17 MOD -5,17.9 MOD 5,&7FFFFFFF MOD 10
X=23:X MOD=7:PRINT X:Y=-7:Y DIV=2:PRINT Y
PRINT NOT 0,NOT -1,NOT 5,NOT &7FFFFFFF,NOT(1=1)
PRINT 5 OR 10,-20 OR 11,(1=2 OR 2=2),&F0 OR &0F
PRINT PI,2*PI,PI/4,-PI
REM (no POS: under CP/M the Z80 version's POS is always 0)
10 REM NEXT, ON ... GOTO/GOSUB/PROC, OTHERWISE
20 FOR i=1 TO 3:FOR j=1 TO 2:PRINT i*j;:NEXT:NEXT:PRINT
30 FOR i=1 TO 3:FOR j=1 TO 2:PRINT i+j;:NEXT j,i:PRINT
40 FOR k=1 TO 5
50   ON k GOTO 60,70,80 ELSE PRINT "else ";k:GOTO 90
60   PRINT "one":GOTO 90
70   PRINT "two":GOTO 90
80   PRINT "three"
90 NEXT
100 FOR k=1 TO 3:ON k GOSUB 200,210,220:NEXT
110 FOR k=1 TO 4:ON k PROCa,PROCb(k),PROCc ELSE PRINT "x"
115 NEXT
120 FOR k=1 TO 3
130   CASE k OF
140     WHEN 1:PRINT "first"
150     OTHERWISE PRINT "other ";k
160   ENDCASE
170 NEXT
180 ON ERROR PRINT REPORT$;" ";ERR:END
190 k=7:ON k GOTO 60,70
195 END
200 PRINT "g1":RETURN
210 PRINT "g2":RETURN
220 PRINT "g3":RETURN
230 DEF PROCa:PRINT "proc a":ENDPROC
240 DEF PROCb(n):PRINT "proc b ";n:ENDPROC
250 DEF PROCc:PRINT "proc c":ENDPROC
RUN
NEW
10 REM OPENIN, OPENOUT, OPENUP, OSCLI, PAGE
20 F%=OPENOUT "K03DATA":PRINT#F%,"line one",42,"line two":CLOSE#F%
30 F%=OPENUP "K03DATA":PTR#F%=0:INPUT#F%,a$,n:PRINT a$;n:PTR#F%=PTR#F%:PRINT#F%,"changed":CLOSE#F%
40 F%=OPENIN "K03DATA":INPUT#F%,a$,n,b$:PRINT a$;n;b$:CLOSE#F%
50 PRINT OPENIN "K03NONE"
60 OSCLI "ERA K03DATA"
70 PRINT OPENIN "K03DATA"
80 PRINT (PAGE AND 255)=0 OR TRUE
RUN
NEW
10 REM PRINT: formatting, @%, ~, ', TAB, SPC
20 PRINT 1,22,333
30 PRINT 1;22;333
40 PRINT "a","b";"c"'"d"''"e"
50 PRINT ~255,~-1,~&ABCDEF
60 PRINT ;1;" ";~16
70 @%=&20305:PRINT PI,1/3,100
80 @%=&10305:PRINT PI,1/3,1E6
90 @%=&0A:PRINT PI,1/3,123456789
100 @%=&00090A:PRINT PI*1E10,2/3
110 @%=&1020A:PRINT 1.5,-2.25,1E-5
120 @%=10:PRINT TAB(5);"x";TAB(10);"y";TAB(2);"z"
130 PRINT SPC(3);"s";SPC(0);"t";SPC(-1);"u"
140 PRINT "a",TAB(20)"b"
150 X=3:PRINT X,-X,X*1E20,X/1E20,1E38,-0.5
160 PRINT 2^31,-2^31,2147483647,-2147483647-1,1E10
170 PRINT 0.1+0.2,1/7,100/3,1E-9,123456789012
180 PRINT "end";
190 PRINT
RUN
@%=10
PRINT "abc",
PRINT 12345678901,
PRINT "x";:PRINT
