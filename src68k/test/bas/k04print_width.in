REM keywords PRINT# to WIDTH, from the manual's examples (bbcwin7)
PRINT RAD(90),RAD(-45),DEG(RAD(33))
PRINT SGN(-3.5),SGN(0),SGN(7),SGN(-0.0001)
PRINT SIN(0),SIN(PI/2),SIN(RAD(30)),SIN(-PI)
PRINT SQR(16),SQR(2),SQR(0),SQR(1E10)
PRINT TAN(0),TAN(PI/4),TAN(RAD(60))
A$="BBC BASIC":PRINT RIGHT$(A$,5);"|";RIGHT$(A$,0);"|";RIGHT$(A$,20);"|";RIGHT$(A$)
A$="BBC BASIC":RIGHT$(A$,3)="xyz":PRINT A$:RIGHT$(A$)="!":PRINT A$
PRINT STR$(1.5);"|";STR$(-7);"|";STR$~255;"|";STR$(1E10);"|";STR$(1/3)
@%=&20205:PRINT STR$(PI):@%=10:PRINT STR$(PI)
PRINT STRING$(5,"ab");"|";STRING$(0,"x");"|";STRING$(3,"");"|";LEN(STRING$(255,"z"))
PRINT VAL("12.5"),VAL("-3E2"),VAL("abc"),VAL("  7x"),VAL("&FF"),VAL("1E-3")
PRINT TRUE,TRUE AND 7,-TRUE
A=1:B=2:SWAP A,B:PRINT A;B:A$="x":B$="y":SWAP A$,B$:PRINT A$;B$
DIM P%(2),Q%(2):P%()=1,2,3:Q%()=7,8,9:SWAP P%(),Q%():PRINT P%(0);P%(2);Q%(1)
DIM S(3):S()=1.5,2,3,4:PRINT SUM(S()),SUM(P%()):DIM T$(2):T$()="ab","c","def":PRINT SUM(T$()),SUMLEN(T$())
VDU 65,66,67:VDU 10,13:VDU 72,73:PRINT
PRINT TOP-PAGE>0
10 REM PRINT#, PTR#, READ#, REPEAT, REPORT, RESTORE, RETURN
20 F%=OPENOUT "K04DATA"
30 PRINT#F%,1,-2.5,"three",&7FFFFFFF:p%=PTR#F%
40 CLOSE#F%
50 F%=OPENIN "K04DATA"
60 INPUT#F%,a,b,c$:PRINT a;b;c$;" at ";PTR#F%
70 READ#F%,d:PRINT d;" at ";PTR#F%;" of ";p%
80 PTR#F%=0:INPUT#F%,a:PRINT a:CLOSE#F%
90 n=0:REPEAT n=n+1:UNTIL n>=3:PRINT n
100 REPEAT:n=n-1:PRINT n;:UNTIL n=0:PRINT
110 ON ERROR REPORT:PRINT " (";ERR;")":GOTO 130
120 PRINT SQR(-1)
130 ON ERROR REPORT:PRINT " (";ERR;")":GOTO 150
140 PRINT LN(0)
150 ON ERROR REPORT:PRINT " (";ERR;")":GOTO 170
160 PRINT 1E38*1E10
170 ON ERROR REPORT:PRINT " (";ERR;")":GOTO 190
180 PRINT ASN(2)
190 ON ERROR OFF
200 RESTORE 260:READ x,y$:PRINT x;y$
210 RESTORE:READ x:PRINT x
220 GOSUB 240:PRINT "returned"
230 GOTO 270
240 PRINT "in sub":RETURN
250 DATA 99
260 DATA 3,"str"
270 PROCfirst
280 STOP
290 PRINT "not here"
300 DEF PROCfirst:LOCAL I%:FOR I%=1 TO 2:PROCsecond(I%):NEXT:ENDPROC
310 DEF PROCsecond(J%):PRINT "second ";J%:ENDPROC
RUN
*ERA K04DATA
NEW
10 REM RND with a seed, TRACE, WHILE, WIDTH, USR and the ones the
20 REM manual lists: STEP, THEN, TO, UNTIL, WHEN
30 X=RND(-42):FOR i=1 TO 4:PRINT RND(100);:NEXT:PRINT
40 X=RND(-42):PRINT RND(100);RND(1)<1;RND(0)=RND(0);RND(1)>=0
50 X=RND(-7):A=RND(1):X=RND(-7):PRINT A=RND(1)
60 FOR i=10 TO 1 STEP -3:PRINT i;:NEXT:PRINT
70 i=0:WHILE i<3:i+=1:PRINT "w";i;:ENDWHILE:PRINT
80 WHILE FALSE:PRINT "never":ENDWHILE:PRINT "skipped"
90 TRACE ON:x=1
100 x=2
110 TRACE OFF:PRINT
120 WIDTH 20:PRINT "0123456789012345678901234567890":PRINT 1,2,3,4,5:WIDTH 0
130 PRINT "after width"
RUN
TRACE 105:RUN
TRACE OFF
