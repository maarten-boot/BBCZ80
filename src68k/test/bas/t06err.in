10 ON ERROR PRINT "err ";ERR;" ";REPORT$;" at ";ERL:GOTO 40
20 X=1/0
30 PRINT "not here"
40 ON ERROR OFF
50 PRINT "next"
60 ON ERROR LOCAL PRINT "local ";ERR:GOTO 85
70 Y=SQR(-1)
80 PRINT "skipped"
85 ON ERROR OFF:PRINT EVAL("2*3");EVAL("""a""+""b""")
90 ERROR 100,"custom"
RUN
PRINT 1/0
PRINT nosuch
PRINT "a"+1
GOTO 999
