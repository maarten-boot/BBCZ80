10 DIM code% 100
20 P%=code%:[OPT FN1("test")
30 ]
40 PRINT "issue 1: ";$code%
50 P%=code%:[OPT 0:nop:OPT FNm("AB"):nop:OPT FNm("CDE"):rts:]
60 PROCdump
70 P%=code%:[OPT 0:OPT FNr(5):rts:]
80 PROCdump
90 P%=&3000:O%=code%:[OPT 4:move.l #FNk(5),d0:]
100 P%=&3006:O%=code%:[OPT 4:dc.b FNb:bogus:]
110 END
200 REM Mr Russell's macro (GitHub issue 1)
210 DEF FN1(A$)
220 [OPT 2
230 dc.b A$,13
240 ]
250 = 2
300 DEF FNm(A$)
310 [OPT 0:dc.b A$:]
320 =0
400 DEF FNr(N%)
410 IF N%=0 THEN =0
420 [OPT 0:dc.b N%:OPT FNr(N%-1):]
430 =0
500 DEF FNk(N%)
510 [OPT 0:]
520 =N%*3
600 DEF FNb
610 [OPT 0:]
620 =1
700 DEF PROCdump:LOCAL a%:PRINT P%-code%;":";
710 FOR a%=code% TO P%-1:PRINT " ";RIGHT$("0"+STR$~?a%,2);:NEXT:PRINT:ENDPROC
RUN
PRINT "alive"
