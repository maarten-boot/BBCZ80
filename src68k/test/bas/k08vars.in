REM the general chapter (bbcwin2): variables, arrays, indirection,
REM expressions (not the BBC BASIC for Windows things: structures, 64-bit
REM and byte variables, ] and $$, line continuation)
10 REM variable names and types
20 Count%=7:count%=8:COUNTER=9:name$="n":Name$="N":a_b_c=1.5:A1B2%=-3
30 PRINT Count%;count%;COUNTER;" ";name$;Name$;a_b_c;A1B2%
40 PRINT 7/2;7 DIV 2;7.9:X%=7.9:PRINT X%:X%=-7.9:PRINT X%
50 v=2147483647:PRINT v:v=v+1:PRINT v:i%=2147483647:PRINT i%
60 v=0.1:PRINT v*3;v*3=0.3:v=1/3:PRINT v*3=1
70 Value+=1:PRINT Value:s$+="x":PRINT s$
80 PRINT ELEPHANT%;ZEBRA$
90 END
RUN
@%=10:A%=1:B%=2:Z%=26:PRINT A%;B%;Z%
CLEAR:PRINT A%;B%;Z%;" static"
NEW
PRINT A%;Z%;" after NEW"
10 REM arrays: DIM, whole-array operations, initialising, slicing
20 DIM marks%(10,5),A(4),B(4),C(4),A$(2),B$(2),C$(2),D$(2),V(2),W(2)
30 PRINT DIM(marks%());DIM(marks%(),1);DIM(marks%(),2)
40 A()=1,2,3,4,5:B()=PI:C()=A()*2:PRINT C(0);C(4);B(3)
50 C()=A()-0.5:PRINT C(1):C()=A()*C()+B():PRINT C(2)
60 C()=B()*2/C()+3-A():PRINT C(0);C(4)
70 A()*=2.5:PRINT A(1):A()+=1:PRINT A(1):A()/=2:PRINT A(4):A()-=A():PRINT SUM(A())
80 A$()="Alpha","Beta","Gamma":B$()="-":C$()="!",".","?"
90 D$()=A$()+B$()+C$():PRINT D$(0);D$(1);D$(2);SUMLEN(D$())
100 V()=1,2,3:W()=4,5,6:DIM R(0):R()=V().W():PRINT R(0)
110 DIM M(1,2),N(2,1),P(1,1):M()=1,2,3,4,5,6:N()=7,8,9,10,11,12:P()=M().N()
120 PRINT P(0,0);P(0,1);P(1,0);P(1,1)
130 PRINT SUM(V())/(DIM(V(),1)+1);MOD(W())
140 DIM I%(3):I%()=5:I%()=I%()+I%():PRINT SUM(I%());I%(3)
150 PRINT SUM(marks%());SUMLEN(B$())
RUN
NEW
10 REM indirection: ? ! $ and the ^ operator
20 DIM M 15:?M=&23:PRINT ?M:number=?M:PRINT ~number
30 M?5=&50:PRINT M?5;?(M+5)
40 !M=&12345678:PRINT ~!M;" ";~?M;" ";~M?3:PRINT ~M!1
50 FOR i%=0 TO 3:PRINT ~M?i%;" ";:NEXT:PRINT
60 $M="hello":PRINT $M;" ";M?5;LEN($M):$(M+1)="ELLO":PRINT $M
70 ?M=256+65:PRINT ?M:!M=-1:PRINT !M;M?0;M?3
80 A%=1234:PRINT !^A%:B%=&01020304:P%=^B%:PRINT ?P%;P%?3
90 T%=P%?0:P%?0=P%?3:P%?3=T%:T%=P%?1:P%?1=P%?2:P%?2=T%:PRINT ~B%
100 FOR ?M=0 TO 3:PRINT ?M;:NEXT:PRINT
110 X=1.5:P%=^X:PRINT P%?4;P%?3:Y=0:Q%=^Y:!Q%=!P%:Q%?4=P%?4:PRINT Y
120 REM (not ^S$: a string descriptor is 6 bytes here, 4 in the Z80 version)
130 DIM N% 7:N%!0=0:N%!4=0:N%?2=7:PRINT !N%;N%!1;N%!2
RUN
NEW
10 REM expressions: the order of evaluation, the manual's examples
20 A=2:B=3:C=2:D=4
30 IF A=2 AND B=3 THEN PRINT "1 yes"
40 IF ((A=2)AND(B=3))THEN PRINT "2 yes"
50 A=1:IF A=1 OR C=2 AND B=3 THEN PRINT "3 yes"
60 IF((A=1)OR((C=2)AND(B=3)))THEN PRINT "4 yes"
70 IF NOT(A=1 AND B=2) THEN PRINT "5 yes"
80 A=6:N=A+B/C-D:PRINT N;A+(B/C)-D;A/B+C/D;(A/B)+(C/D)
90 PRINT 2^3^2;-2^2;(-2)^2;2*-3;-3 MOD 2;7 DIV 2*2;1+2*3-4/2
100 PRINT (1<2)=TRUE;1+1=2 AND 3;3 OR 4 AND 5;NOT 1+1;NOT(1+1)
110 PRINT 1<<4;256>>4;-256>>4;-256>>>4;1<<31;3 EOR 5 OR 8
120 PRINT "a"<"b";"abc"<"abd";"B"<"a";"abc"="abc ";""<"a";"Z"+"z"
130 PRINT &FF+&100;&FFFF;%1010;-&1;~-&1;&7FFFFFFF+1
140 PRINT 1E3;1.5E-3;.5;5.;1E+2;-0;1E38/10*10
150 PRINT 3+-+-2;--3;+5;10-2-3;100/10/5;2^-1
160 a=10:a+=5:a-=3:a*=2:a/=4:PRINT a:b%=17:b%DIV=5:PRINT b%:b%MOD=2:PRINT b%
170 c%=12:c%AND=10:PRINT c%:c%OR=1:PRINT c%:c%EOR=15:PRINT c%
180 c$="Hello ":c$+="world!":PRINT c$
190 FOR i=1 TO 5 PRINT i;:NEXT:PRINT:FOR i=1 TO 5 : PRINT i; : NEXT:PRINT
RUN
