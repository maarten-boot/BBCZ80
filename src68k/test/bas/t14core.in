PRINT 0;007;999999999;1000000000;2147483647;2147483648;4294967296;12345678901
PRINT 1.5;.5;0.25;1E3;12E2;5.;0000000001;00000000001;99999999999
PRINT 2147483647+1;-2147483647-2;&7FFFFFFF+&7FFFFFFF;&80000000-1;1+-1;-5-7;100+0.5;3-0.5
PRINT 1=1;1=2;1<2;2<1;1>2;2>1;1<=1;2<=1;1>=1;1>=2;1<>1;1<>2
PRINT -1<1;1<-1;&80000000<0;&7FFFFFFF>&80000000;0=-0;1.5>1;1<1.5;2=2.0;-3<=-3.0
A%=5:B%=7:PRINT A%+B%;A%-B%;B%-A%;A%<B%;A%>B%;A%=B%;A%+B%*2-1;(A%+B%)*(A%-B%)
10 FOR I%=1 TO 4
20 IF I%=2 THEN PRINT "two" ELSE IF I%=3 PRINT "three" ELSE PRINT "other ";I%
30 IF I%=9 THEN PRINT "ELSE in "" quotes : x" ELSE PRINT "quote skip ";I%
40 IF I%=9 THEN REM ELSE PRINT "hidden"
50 IF I%<>9 THEN PRINT "x";:IF I%=1 THEN PRINT "y" ELSE PRINT "z"
60 IF I%=9 PRINT "a":PRINT "b" ELSE PRINT "c"
70 NEXT
80 X=0:FOR I%=1 TO 10:X=X+I%:IF X>20 THEN PRINT "big";X:I%=10
90 NEXT
RUN
