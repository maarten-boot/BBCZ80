10 DIM code% 400, buf% 40
20 FOR pass%=0 TO 2 STEP 2
30 P%=code%
40 [OPT pass%
50 .sum moveq #0,d0 ; d0 = 1+2+...+d1 (B%)
60 .loop add.l d1,d0:subq.l #1,d1
70 bne loop \ back
80 rts
90 .fwd bra.s later
100 dc.b "skip"
110 .later moveq #7,d0
120 rts
130 .strrev movea.l d2,a0 ; reverse the string at C%, length D%
140 lea 0(a0,d3.w),a1
150 lsr.w #1,d3
160 bra.s rv2
170 .rv1 move.b (a0),d4
180 move.b -(a1),(a0)+
190 move.b d4,(a1)
200 .rv2 dbra d3,rv1
210 rts
220 .mul32 move.l d0,d2 : mulu d1,d2 : move.l d2,d0 : rts
230 .table dc.w 10,20,30,40
240 .index lea table(pc),a0 : add.w d1,d1 : move.w 0(a0,d1.w),d0 : ext.l d0 : rts
250 ]
260 NEXT
270 B%=100:PRINT USR(sum)
280 PRINT USR(fwd)
290 $buf%="Hello, world":C%=buf%:D%=LEN$buf%:CALL strrev:PRINT $buf%
300 A%=1234:B%=5678:PRINT USR(mul32)
310 B%=2:PRINT USR(index)
320 PRINT P%-code%
RUN
P%=&1000:O%=code%:[OPT 6:.x bra x:]
PRINT ~?code%;~code%?1;~code%?2;~code%?3;~P%;~O%-code%
P%=&2000:O%=code%:[OPT 7:.lab nop:move.l #&12345678,d0 ; a comment:rts:]
[OPT 0:.lab nop:]
P%=code%:[OPT 2:bra.s code%+1000:]
P%=code%:[OPT 2:mov d0,d1:]
P%=code%:[OPT 2:moveq #300,d0:]
P%=code%:[OPT 0:moveq #300,d0:]:PRINT ~?code%;~code%?1
P%=code%:[OPT 2:add.b a0,d0:]
P%=code%:[OPT 2:lea d0,a0:]
P%=code%:[OPT 2:bra nowhere:]
P%=code%:[OPT 0:bra nowhere:]:PRINT "pass 1 ok"
