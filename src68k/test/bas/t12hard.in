10 ON ERROR PRINT "trap ";REPORT$;" ";ERL:GOTO 60
20 G=1:PROCbad(5)
30 PRINT "not here"
60 ON ERROR OFF:PRINT "G=";G
70 A$="one":B$="two":PROCsw(A$,B$):PRINT A$;" ";B$
80 PROCsa(4)
90 N%=0:PROCcount:PRINT "count ";N%
100 X=1:Y=2:PROCr2(X,Y):PRINT X;Y
110 PRINT FNe
120 S$="abc":PROCrs(S$):PRINT S$
130 PROCbig
140 END
200 DEF PROCbad(G):LOCAL H:H=G:PRINT 1/0:ENDPROC
210 DEF PROCsw(RETURN a$,RETURN b$):LOCAL t$:t$=a$:a$=b$:b$=t$:ENDPROC
220 DEF PROCsa(n):LOCAL s$():DIM s$(n):FOR i=0 TO n:s$(i)=STRING$(i*3,"s"):NEXT:PRINT s$(n):ENDPROC
230 DEF PROCcount:N%+=1:IF N%<500 PROCcount
240 ENDPROC
250 DEF PROCr2(RETURN Y,RETURN X):X=X*100:Y=Y+0.5:ENDPROC
260 DEF FNe:ON ERROR LOCAL =-1
270 =SQR(-1)
280 DEF PROCrs(RETURN s$):s$=s$+s$:s$=LEFT$(s$,4):ENDPROC
290 DEF PROCbig:LOCAL ERROR:ON ERROR LOCAL PRINT "big: ";REPORT$:ENDPROC
300 DIM Z(1000000)
310 ENDPROC
RUN
PRINT FNnorec
DEF FNnorec=FNnorec
