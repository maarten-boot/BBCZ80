10 REM a text program: "quotes", AND OR EOR
20 DATA 1,two,"three, four"
30 FOR I%=1 TO 3:READ A$:PRINT I%;" ";A$:NEXT
40 IF I%>3 THEN PRINT "yes" ELSE PRINT "no"
50 PROCx(3)
60 END
70 DEF PROCx(N%):LOCAL J%:FOR J%=1 TO N%:PRINT J%;:NEXT:PRINT:ENDPROC
SAVE "TPROG.BAS"
NEW
LOAD "TPROG.BAS"
LIST
RUN
NEW
CHAIN "TPROG.BAS"
F%=OPENIN "TPROG.BAS":L%=EXT#F%:A$=GET$#F%:CLOSE#F%:PRINT L%;" ";A$
AUTO 10,300
*ERA TPROG.BAS
