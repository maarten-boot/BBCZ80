10 FOR I=1 TO 4
20 CASE I OF
30 WHEN 1:PRINT "one"
40 WHEN 2,3:PRINT "two or three"
50 OTHERWISE PRINT "other"
60 ENDCASE
70 NEXT
80 C$="b":CASE C$ OF WHEN "a":PRINT "A" WHEN "b":PRINT "B":ENDCASE
90 FOR I=1 TO 10:IF I=3 EXIT FOR
100 NEXT:PRINT "exit at ";I
110 J=0:REPEAT J+=1:IF J=5 EXIT REPEAT
120 UNTIL FALSE:PRINT "J=";J
130 PROCloc(3):PROCloc(2)
140 FOR K=1 TO 200:S$=STRING$(K MOD 50,"z"):T$=S$+S$:NEXT:PRINT LEN T$
150 PRINT FNdeep(150)
160 DIM Q$(20):FOR K=0 TO 20:Q$(K)=STRING$(K,"q"):NEXT:FOR K=0 TO 20:Q$(K)="":NEXT:PRINT "freed"
170 READ A$,B,C%:PRINT A$;B;C%:READ A$:PRINT A$
180 RESTORE 300:READ A$:PRINT A$
190 X=5:Y=7:SWAP X,Y:PRINT X;Y
200 PRINT TRUE;FALSE;PI;-PI
210 TRACE ON:GOSUB 400:TRACE OFF
220 PRINT FNs$("x",5)
230 A%=3:B%=A%<<2:C%=-16>>2:D%=-16>>>2:PRINT B%;C%;D%
240 END
250 DEF PROCloc(n):LOCAL D():DIM D(n):D(n)=n:PRINT DIM(D(),1);D(n):ENDPROC
260 DEF FNdeep(n):IF n=0 THEN =0 ELSE =1+FNdeep(n-1)
270 DEF FNs$(a$,n):LOCAL i,r$:FOR i=1 TO n:r$+=a$:NEXT:=r$
290 DATA "first",2.5,3
300 DATA "restored"
400 PRINT "sub"
410 RETURN
RUN
