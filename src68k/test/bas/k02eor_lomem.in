REM keywords EOR to LOMEM, from the manual's examples (bbcwin5)
PRINT -20 EOR 11,&F0 EOR &FF,(2=2 EOR 3=3),(2=2 EOR 3=4)
A=2:B=3:answer=(A=2 EOR B=3):PRINT answer:X=7:A=X EOR 11:PRINT A
PRINT EXP(0),EXP(1),EXP(-1),EXP(LN(2.5)+LN(2))
PRINT LN(1),LN(10),LOG(1000),10^(LOG(2.5)+LOG(2)),LOG(0.001)
PRINT INT(99.8),INT(-12),INT(-12.1),INT(14.56),INT(-14.5)
x%=INT(-14.5):PRINT x%:x%=-14.5:PRINT x%:x%=14.5:PRINT x%
PRINT INSTR("FRED BERT JIM","JIM"),INSTR("abcabc","bc",3),INSTR("abc",""),INSTR("","a"),INSTR("abc","abcd")
PRINT INSTR("abc","",2),INSTR("abc","c",9),INSTR("aaa","a",0)
PRINT LEN"fred",LEN(""),LEN("BBC BASIC"+"!")
A$="hello":PRINT LENA$
name$="BBC BASIC":FOR i=0 TO 10:PRINT "[";LEFT$(name$,i);"]";:NEXT:PRINT
A$="BBC BASIC":PRINT LEFT$(RIGHT$(A$,3),2);" ";LEFT$(A$);" ";LEFT$(A$,-1)
A$="BBC BASIC":LEFT$(A$,3)="ZZ":PRINT A$:LEFT$(A$)="QQQQQ":PRINT A$
LET X=4:X=X+4:LET Y$="let":PRINT X;Y$
PRINT FALSE,TRUE,NOT FALSE,FALSE=0
Q=2:P=3:X=2:Y=5:PRINT EVAL("X^Q+Y^P"),EVAL"""ab""+""cd""",EVAL("SQR(16)")
A$="LEN(""four"")*2":PRINT EVAL(A$):PRINT EVAL("PI")
10 REM ERR, ERL, ERROR, ON ERROR
20 ON ERROR PRINT "trapped ";ERR;" at ";ERL;": ";:REPORT:PRINT:GOTO 60
30 PRINT 1/0
40 PRINT "not here"
50 END
60 ON ERROR PRINT ERR;" ";ERL;" ";:REPORT:PRINT:GOTO 90
70 PRINT "resumed"
80 ERROR 100,"Fault"
90 ON ERROR OFF
100 PROCtry(3):PROCtry(0):PRINT "after try"
110 ON ERROR PRINT "end: ";ERR:END
120 ERROR 255,"Custom error"
130 DEF PROCtry(n)
140 ON ERROR LOCAL PRINT "local trap ";ERR:ENDPROC
150 PRINT 12/n
160 ENDPROC
RUN
NEW
10 REM FOR, EXIT, GOSUB, GOTO
20 FOR temperature%=0 TO 9:NEXT:PRINT temperature%
30 DIM A(2,3,1)
40 FOR A(2,3,1)=9 TO 1 STEP -2.5:PRINT A(2,3,1);:NEXT:PRINT
50 start=4: end=20: step=4
60 FOR counter=start TO end STEP step:PRINT counter," ",counter^2:NEXT
70 FOR i=1 TO 0:PRINT "once";:NEXT:PRINT " ";i
80 FOR i=0.1 TO 0.5 STEP 0.1:PRINT i;:NEXT:PRINT
90 FOR I%=1 TO 10:IF I%=4 THEN EXIT FOR
100 NEXT I%:PRINT I%
110 R%=0:REPEAT:R%+=1:IF R%=5 EXIT REPEAT
120 UNTIL FALSE:PRINT R%
130 W%=0:WHILE TRUE:W%+=2:IF W%>7 EXIT WHILE
140 ENDWHILE:PRINT W%
150 FOR I%=1 TO 3:FOR J%=1 TO 3:IF J%=2 AND I%=2 EXIT FOR I%
160 PRINT I%;J%;" ";:NEXT J%
165 NEXT I%:PRINT:PRINT I%;J%
170 answer=1:GOSUB (4*answer+196):GOSUB 200:mysub=210:GOSUB (mysub)
180 X=23:GOTO (X*10)
190 END
200 PRINT "sub 200":RETURN
210 PRINT "sub 210":RETURN
230 PRINT "goto 230";FN_fact(10);FN_mean(1,2,3,6)
240 END
250 DEF FN_fact(N):IF N<2 THEN =1 ELSE =N*FN_fact(N-1)
260 DEF FN_mean(Q1,Q2,Q3,Q4)=(Q1+Q2+Q3+Q4)/4
RUN
NEW
10 REM IF, LOCAL, LOCAL DATA, EXT#, HIMEM and LOMEM
20 FOR age=19 TO 22
30   IF age<21 THEN PRINT "Under 21" ELSE PRINT "21 or over"
40   flag=age<21:IF flag THEN PRINT "flag";flag
50   IF age>21 PRINT "older":GOTO 70
60   IF age=20 THEN 80
70 NEXT:END
80 PRINT "line 80":GOTO 70
RUN
NEW
10 A$="global":X=1:PROCloc:PROCdata:PRINT A$;X
20 READ p$:PRINT p$
30 h%=HIMEM:HIMEM=HIMEM-40:PRINT h%-HIMEM:HIMEM=h%
40 L%=LOMEM:LOMEM=LOMEM+100:PRINT LOMEM-L%
50 F%=OPENOUT "K02DATA":PRINT#F%,"abc",1.5,7:PRINT PTR#F%:CLOSE#F%
60 F%=OPENIN "K02DATA":INPUT#F%,s$,r,i%:PRINT s$;r;i%:CLOSE#F%
70 END
80 DEF PROCloc:LOCAL A$,X:A$="local":X=2:PRINT A$;X:ENDPROC
85 REM (the Z80 version: "DATA not LOCAL" if LOCAL X comes before LOCAL DATA)
90 DEF PROCdata:LOCAL DATA
100 RESTORE +1
110 DATA "Here", "is", "some", "local", "data"
120 READ A$, B$, C$, D$, E$:PRINT A$;B$;C$;D$;E$:A$="global"
130 RESTORE DATA
140 ENDPROC
150 DATA "outer"
RUN
*ERA K02DATA
