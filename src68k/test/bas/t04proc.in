10 A=1:B=2:PROCswap(A,B):PRINT A;B
20 PROCret(A,B):PRINT A;B
30 X$="hi":PROCs(X$):PRINT X$
40 DIM N(3):N(1)=5:PROCarr(N()):PRINT N(1);N(2)
50 PRINT FNrec(5);FNstr$("ab")
60 PROCloc:PRINT Q
70 LOCAL_TEST=3:PROCdeep(3):PRINT "done"
80 END
100 DEF PROCswap(B,A):PRINT A;B:ENDPROC
110 DEF PROCret(RETURN A,RETURN B):A=A*10:B=B*10:ENDPROC
120 DEF PROCs(RETURN s$):s$=s$+"!":ENDPROC
130 DEF PROCarr(a()):a(2)=a(1)*2:ENDPROC
140 DEF FNrec(n):IF n=0 THEN =0 ELSE =n+FNrec(n-1)
150 DEF FNstr$(s$)=s$+s$+STRING$(3,"-")
160 DEF PROCloc:LOCAL Q:Q=99:PRINT Q:ENDPROC
170 DEF PROCdeep(n):LOCAL a$,b%:a$=STR$(n):b%=n:IF n>0 PROCdeep(n-1)
180 PRINT a$;b%;:ENDPROC
RUN
