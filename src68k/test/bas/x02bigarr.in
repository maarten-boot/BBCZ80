10 DIM A%(70000):PRINT DIM(A%(),1)
20 A%(70000)=7:A%(4464)=3:PRINT A%(70000);A%(4464)
30 DIM B%(300,300):PRINT DIM(B%(),1);DIM(B%(),2):B%(300,300)=5:B%(0,0)=1:B%(299,1)=9:PRINT B%(300,300);B%(0,0);B%(299,1)
40 DIM C%(65535):PRINT DIM(C%(),1):C%(65535)=3:PRINT C%(65535);SUM(C%())
50 A%()=1:PRINT SUM(A%()):A%()+=1:PRINT SUM(A%())
55 CLEAR:DIM A%(70000),D%(70000):A%()=2:D%()=A%():PRINT SUM(D%());DIM(A%())
60 CLEAR:DIM S$(70000):S$()="ab":S$(70000)="xyz":PRINT SUMLEN(S$());" ";S$(70000);S$(0)
100 ON ERROR PRINT REPORT$:GOTO 120
110 PRINT S$(70001)
120 ON ERROR PRINT REPORT$:GOTO 140
130 PRINT S$(-1)
140 ON ERROR OFF
150 CLEAR:DIM R%(0),M%(0,66000),V%(66000):M%()=1:V%()=2:M%(0,66000)=11:R%()=M%().V%():PRINT R%(0)
160 PRINT "done"
RUN
