   10 REM basic statements
   20 A=1.5:B%=7:C$="abc"
   30 PRINT A;B%;C$
   40 FOR I=1 TO 5 STEP 2:PRINT I;:NEXT:PRINT
   50 J=0:REPEAT J=J+1:UNTIL J>3:PRINT J
   60 K=0:WHILE K<4 K+=1:ENDWHILE:PRINT K
   70 IF A>1 THEN PRINT "yes" ELSE PRINT "no"
   80 GOSUB 200
   90 PRINT FNsq(7), FNfact(10)
  100 PROCp("x",3)
  110 DIM Z(3),Z$(2):Z(2)=9:Z$(1)="q":PRINT Z(2);Z$(1)
  120 PRINT LEFT$(C$,2);MID$(C$,2,1);RIGHT$(C$,1);LEN(C$);ASC(C$);CHR$(65)
  130 PRINT INSTR("hello","ll");STR$(3.25);VAL("12.5");~255
  140 RESTORE:READ X,Y$:PRINT X;Y$
  150 ON 2 GOTO 160,170
  160 PRINT "bad"
  170 PRINT "on ok"
  180 PRINT 7 DIV 2;7 MOD 3;2^10;SQR(2);SIN(1);INT(-2.5);ABS(-3)
  190 END
  200 PRINT "gosub":RETURN
  210 DEF FNsq(x)=x*x
  220 DEF FNfact(n):IF n<2 THEN =1 ELSE =n*FNfact(n-1)
  230 DEF PROCp(s$,n):LOCAL i:FOR i=1 TO n:PRINT s$;:NEXT:PRINT:ENDPROC
  240 DATA 42,"data"
